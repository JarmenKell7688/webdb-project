@model WebApplication2.Models.ApplicationUser

@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student Number</dt>
            <dd class="col-sm-9">@(Model.StudentNumber ?? "Not assigned")</dd>

            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@(Model.FirstName ?? "N/A")</dd>

            <dt class="col-sm-3">Last Name</dt>
            <dd class="col-sm-9">@(Model.LastName ?? "N/A")</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "N/A")</dd>

            <dt class="col-sm-3">Program</dt>
            <dd class="col-sm-9">@(Model.Program ?? "Not specified")</dd>

            <dt class="col-sm-3">Year Level</dt>
            <dd class="col-sm-9">@(Model.YearLevel?.ToString() ?? "Not specified")</dd>

            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@(Model.UserName ?? "N/A")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>