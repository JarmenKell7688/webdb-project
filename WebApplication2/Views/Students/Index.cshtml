@model IEnumerable<WebApplication2.Models.ApplicationUser>

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Student Number</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Program</th>
            <th>Year Level</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var student in Model)
            {
                <tr>
                    <td>@(student.StudentNumber ?? "N/A")</td>
                    <td>@(student.FirstName ?? "N/A")</td>
                    <td>@(student.LastName ?? "N/A")</td>
                    <td>@(student.Email ?? "N/A")</td>
                    <td>@(student.Program ?? "N/A")</td>
                    <td>@(student.YearLevel?.ToString() ?? "N/A")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-info">Details</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No students found</td>
            </tr>
        }
    </tbody>
</table>