@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-4">Welcome, @ViewBag.AdminName</h1>

    <div class="row">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Students</h5>
                    <h2>@ViewBag.TotalStudents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Faculty</h5>
                    <h2>@ViewBag.TotalFaculty</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Requests</h5>
                    <h2>@ViewBag.TotalRequests</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Pending Requests</h5>
                    <h2>@ViewBag.PendingRequests</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4>Quick Actions</h4>
                </div>
                <div class="card-body">
                    <a href="#" class="btn btn-primary btn-lg btn-block mb-2 w-100">View All Requests</a>
                    <a href="#" class="btn btn-success btn-lg btn-block mb-2 w-100">View Users</a>
                    <a href="#" class="btn btn-info btn-lg btn-block w-100">Create Faculty Account</a>
                </div>
            </div>
        </div>
    </div>
</div>