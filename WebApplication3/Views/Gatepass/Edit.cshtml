@model WebApplication3.Models.GatepassViewModel
@{
    ViewData["Title"] = "Edit Vehicle Registration";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h3>@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="SchoolYear" class="form-label"></label>
                            <input asp-for="SchoolYear" class="form-control" />
                            <span asp-validation-for="SchoolYear" class="text-danger"></span>
                        </div>

                        <h5 class="mb-3">Personal Information (Read-only)</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <input asp-for="Name" class="form-control" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ID Number</label>
                                <input asp-for="CustomId" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ApplicationDate" class="form-label"></label>
                            <input asp-for="ApplicationDate" class="form-control" type="date" />
                            <span asp-validation-for="ApplicationDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserType" class="form-label"></label>
                            <div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="UserType" value="Faculty" id="typeFaculty" />
                                    <label class="form-check-label" for="typeFaculty">Faculty</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="UserType" value="Non-Teaching Staff" id="typeStaff" />
                                    <label class="form-check-label" for="typeStaff">Non-Teaching Staff</label>
                                </div>
                            </div>
                            <span asp-validation-for="UserType" class="text-danger"></span>
                        </div>

                        @if (Model.Department != null)
                        {
                            <div class="mb-3">
                                <label asp-for="Department" class="form-label"></label>
                                <input asp-for="Department" class="form-control" />
                                <span asp-validation-for="Department" class="text-danger"></span>
                            </div>
                        }

                        @if (Model.Course != null)
                        {
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Course</label>
                                    <input asp-for="Course" class="form-control" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Year</label>
                                    <input asp-for="Year" class="form-control" readonly />
                                </div>
                            </div>
                        }

                        <hr />
                        <h5 class="mb-3">Vehicle Information</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="VehiclePlateNo" class="form-label"></label>
                                <input asp-for="VehiclePlateNo" class="form-control" />
                                <span asp-validation-for="VehiclePlateNo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RegistrationExpiryDate" class="form-label"></label>
                                <input asp-for="RegistrationExpiryDate" class="form-control" type="date" />
                                <span asp-validation-for="RegistrationExpiryDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="VehicleType" class="form-label"></label>
                                <select asp-for="VehicleType" class="form-select">
                                    <option value="">-- Select Vehicle Type --</option>
                                    <option value="Motorcycle">Motorcycle</option>
                                    <option value="Car">Car</option>
                                    <option value="SUV">SUV</option>
                                    <option value="Van">Van</option>
                                    <option value="Truck">Truck</option>
                                </select>
                                <span asp-validation-for="VehicleType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Maker" class="form-label"></label>
                                <input asp-for="Maker" class="form-control" />
                                <span asp-validation-for="Maker" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Color" class="form-label"></label>
                            <input asp-for="Color" class="form-control" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>

                        <hr />
                        <h5 class="mb-3">Attachments (Optional - Upload new to replace)</h5>

                        @if (!string.IsNullOrEmpty(Model.StudyLoadAttachment))
                        {
                            <div class="alert alert-info">
                                Current Study Load: <a href="@Model.StudyLoadAttachment" target="_blank">View</a>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="StudyLoadFile" class="form-label"></label>
                            <input asp-for="StudyLoadFile" class="form-control" type="file" accept="image/*,.pdf" />
                            <small class="form-text text-muted">Leave empty to keep existing file</small>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.RegistrationAttachment))
                        {
                            <div class="alert alert-info">
                                Current Registration: <a href="@Model.RegistrationAttachment" target="_blank">View</a>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="RegistrationFile" class="form-label"></label>
                            <input asp-for="RegistrationFile" class="form-control" type="file" accept="image/*,.pdf" />
                            <small class="form-text text-muted">Leave empty to keep existing file</small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Update Application</button>
                            <a asp-action="MyRequests" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}