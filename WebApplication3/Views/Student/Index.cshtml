@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-4">Welcome, @ViewBag.FullName</h1>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Your Information</h5>
                    <p><strong>Student ID:</strong> @ViewBag.StudentId</p>
                    <p><strong>Program:</strong> @ViewBag.Program</p>
                    <p><strong>Year:</strong> @ViewBag.Year</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h4>Forms</h4>
                </div>
                <div class="card-body">
                    <a asp-controller="Gatepass" asp-action="Create" class="btn btn-primary btn-lg w-100 mb-2">Vehicle Registration</a>
                    <a asp-controller="Gatepass" asp-action="MyRequests" class="btn btn-secondary btn-lg w-100">View My Requests</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h4>Profile</h4>
                </div>
                <div class="card-body">
                    <a href="#" class="btn btn-info btn-lg w-100">View Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>